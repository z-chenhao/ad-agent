  {
    "name": "recall_memory",
    "description": "Read account-scoped stable operator preferences, constraints, and goals. Memories are never current performance evidence or approval.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "save_memory",
    "description": "Save one stable preference, constraint, or goal only when the operator explicitly asks to remember it or clearly states it is durable. Never save credentials, object IDs, ad content, current metrics, status, or permissions.",
    "parameters": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["preference", "constraint", "goal"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\r\\n]+$"
        }
      },
      "required": ["kind", "text"],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_memory",
    "description": "Delete one account-scoped saved fact only when the operator explicitly requests it.",
    "parameters": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "pattern": "^memory_[a-f0-9]{32}$"
        }
      },
      "required": ["memory_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "discard_change",
    "description": "Discard exactly one unapplied draft on explicit operator request.",
    "parameters": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["change_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "present_metrics",
