          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": ["suggestions"],
      "additionalProperties": false
    }
  },
