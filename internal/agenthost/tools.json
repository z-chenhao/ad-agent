  {
    "name": "get_performance_report",
    "description": "Read inclusive daily performance, returning daily rows for the full date range and a server dataset reference; never average row ratios. Omit entity_id to collect all objects at one level together instead of issuing one call per object or day. This turn can retain eight report snapshots, including application grounding. Reuse returned references (identical completed queries reuse their snapshot); after report_budget_exceeded use existing evidence or narrow the question, not repeated reads. Use run_analysis to filter or calculate across the full bounded dataset.",
    "parameters": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["advertiser", "campaign", "ad_group", "ad"]
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["level", "start_date", "end_date"],
      "additionalProperties": false
    }
  },
