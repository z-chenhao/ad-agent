  {
    "name": "stage_automated_rule_create",
    "description": "Stage an automated rule with explicit targets, conditions, bounded action, and schedule. Initial activation is provider-defined; prefer NOTIFY until platform behavior is validated. Never applies.",
    "parameters": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target_level": {
          "type": "string",
          "enum": ["campaign", "ad_group", "ad"]
        },
        "target_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string",
                "enum": ["SPEND", "CPA", "CTR", "CONVERSIONS"]
              },
              "operator": {
                "type": "string",
                "enum": ["GT", "LT"]
              },
              "value": {
                "type": "string",
                "pattern": "^\\d{1,9}(\\.\\d{1,4})?$"
              },
              "window": {
                "type": "string",
                "enum": ["TODAY", "LAST_3_DAYS", "LAST_7_DAYS"]
              }
            },
            "required": ["metric", "operator", "value", "window"],
            "additionalProperties": false
          }
        },
        "action": {
          "type": "string",
          "enum": ["NOTIFY", "PAUSE", "CHANGE_BUDGET"]
        },
        "action_value": {
          "type": "string",
          "pattern": "^\\d{1,9}(\\.\\d{1,2})?$"
        },
        "schedule": { "type": "string", "enum": ["EVERY_30_MINUTES"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 600 }
      },
      "required": [
        "name",
        "target_level",
        "target_ids",
        "conditions",
        "action",
        "schedule",
        "reason"
      ],
      "additionalProperties": false
    }
  },
