      },
      "required": ["level", "name", "status", "reason"],
      "additionalProperties": false
    }
  },
  {
    "name": "stage_campaign_bundle",
    "description": "Stage one complete disabled campaign, ad group, and 1-20 ads. Validates referenced identities, reviewed assets, audiences, measurement, schedule, optimization, and targeting. Never publishes or applies.",
    "parameters": {
      "type": "object",
      "properties": {
        "campaign": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 512 },
            "objective": {
              "type": "string",
              "enum": ["TRAFFIC", "WEB_CONVERSIONS"]
            },
            "budget_mode": {
              "type": "string",
              "enum": ["BUDGET_MODE_DAY", "BUDGET_MODE_TOTAL"]
            },
            "budget": {
              "type": "string",
              "pattern": "^\\d{1,9}(\\.\\d{1,2})?$"
            }
          },
          "required": ["name", "objective"],
          "additionalProperties": false
        },
        "ad_group": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 512 },
            "budget": {
              "type": "string",
              "pattern": "^\\d{1,9}(\\.\\d{1,2})?$"
            },
            "budget_mode": {
              "type": "string",
              "enum": ["BUDGET_MODE_DAY", "BUDGET_MODE_TOTAL"]
            },
            "billing_event": {
              "type": "string",
              "enum": ["CPC", "CPM", "OCPM"]
            },
            "optimization_goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "optimization_event": { "type": "string", "maxLength": 64 },
            "bid_type": { "type": "string", "maxLength": 64 },
            "bid": { "type": "string", "pattern": "^\\d{1,9}(\\.\\d{1,2})?$" },
            "pacing": {
              "type": "string",
              "enum": ["PACING_MODE_SMOOTH", "PACING_MODE_FAST"]
            },
            "schedule_type": {
              "type": "string",
              "enum": ["SCHEDULE_START_END", "SCHEDULE_FROM_NOW"]
            },
            "schedule_start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
            },
            "schedule_end": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
            },
            "placements": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 64 },
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true
            },
            "location_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 128 },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            },
            "languages": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 64 },
              "maxItems": 20,
              "uniqueItems": true
            },
            "age_groups": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 64 },
              "maxItems": 10,
              "uniqueItems": true
            },
            "gender": {
              "type": "string",
              "enum": ["GENDER_UNLIMITED", "GENDER_MALE", "GENDER_FEMALE"]
            },
            "audience_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 128 },
              "maxItems": 50,
              "uniqueItems": true
            },
            "excluded_audience_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 128 },
              "maxItems": 50,
              "uniqueItems": true
            },
            "pixel_id": { "type": "string", "maxLength": 128 }
          },
          "required": [
            "name",
            "budget",
            "budget_mode",
            "billing_event",
            "optimization_goal",
            "pacing",
            "schedule_type",
            "schedule_start",
            "placements",
            "location_ids"
          ],
          "additionalProperties": false
        },
        "ads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 512 },
              "identity_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "identity_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "asset_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "asset_kind": { "type": "string", "enum": ["image", "video"] },
              "primary_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "call_to_action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "destination_url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              }
            },
            "required": [
              "name",
              "identity_id",
              "identity_type",
              "asset_id",
              "asset_kind",
              "primary_text",
              "call_to_action",
              "destination_url"
            ],
            "additionalProperties": false
          }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 600 }
      },
      "required": ["campaign", "ad_group", "ads", "reason"],
      "additionalProperties": false
    }
  },
