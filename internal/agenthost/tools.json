  {
    "name": "get_entity",
    "description": "Read an exact object before staging a change.",
    "parameters": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["campaign", "ad_group", "ad"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["level", "id"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_performance_report",
    "description": "Read inclusive daily performance. Returns a server dataset reference; never average row ratios.",
    "parameters": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["advertiser", "campaign", "ad_group", "ad"]
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["level", "start_date", "end_date"],
      "additionalProperties": false
    }
  },
  {
    "name": "run_analysis",
    "description": "Delegate a bounded performance diagnosis to an isolated read-only analyst. Pass reports from this turn only.",
    "parameters": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "dataset_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": ["question", "dataset_refs"],
      "additionalProperties": false
    }
  },
  {
    "name": "stage_budget_change",
    "description": "Create a budget draft only; never applies. Read the target first. Currency must match the account.",
    "parameters": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["campaign", "ad_group"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "budget": {
          "type": "string",
          "pattern": "^\\d{1,9}(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "required": ["level", "id", "budget", "currency", "reason"],
      "additionalProperties": false
    }
  },
  {
    "name": "stage_status_change",
    "description": "Create an enable/disable draft only; never applies. Read the exact target first.",
    "parameters": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["campaign", "ad_group", "ad"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["ENABLE", "DISABLE"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "required": ["level", "id", "status", "reason"],
      "additionalProperties": false
    }
  },
