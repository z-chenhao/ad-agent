  {
    "name": "present_digest",
    "description": "Present an optional decision briefing: one topic and at most three distinct, prioritized findings, each with evidence and a concrete next step. Use only when this helps the operator decide; do not repeat the answer, a metric table, or an approval preview. Do not fill unused slots. ref_id must identify an entity grounded in this session or a staged change, never a report, evidence, calculation, comparison, or analysis record. Recommendations are not approvals or executable actions.",
    "parameters": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "opportunity",
                  "warning",
                  "delivery",
                  "measurement",
                  "change"
                ]
              },
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180,
                "description": "A concise evidence-backed finding or judgment, not an instruction, task title, or duplicate of action. Use plain text. Identify the subject with ref_id instead of placing a raw object ID in the headline."
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280,
                "description": "Supporting observed metrics or status, relevant reporting window, and decision-changing uncertainty. Distinguish observation from hypothesis; never fabricate support. Displayed last under collapsed Evidence."
              },
              "ref_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Optional current-session entity ID or staged change ID only. Omit for findings without a grounded entity or change record."
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "A distinct, concrete next step in plain text: what to investigate, prepare, or defer. If observing or holding, specify a relevant review window or trigger rather than generic advice. Displayed under Next step, not a button, follow-up prompt, or approval. Never claim an unverified change succeeded."
              }
            },
            "required": ["kind", "headline", "why", "action"],
            "additionalProperties": false
          }
        }
      },
      "required": ["title", "items"],
      "additionalProperties": false
    }
  },
  {
    "name": "present_suggestions",
    "description": "Present 1–4 optional follow-up prompts that the operator can edit and send. Write complete requests in the operator's voice, with the specific target and investigation or draft task. Do not copy a briefing recommendation or caution verbatim, use vague assent, or imply approval/application. Omit this tool when no useful follow-up exists.",
    "parameters": {
